# ---------------------------------------------------------------------------
# PackWise AI — local environment configuration template.
#
# 1. Copy this file to `.env` in the project root:
#       cp .env.example .env
# 2. Replace the placeholder value below with your real Gemini API key from
#    https://aistudio.google.com/app/apikey
#
# `.env` is git-ignored (see .gitignore) — never commit your real key.
#
# This file is read at runtime via the `flutter_dotenv` package (see
# lib/main.dart + lib/core/constants/api_constants.dart). If you'd rather not
# use a `.env` file at all (e.g. in CI), you can instead pass the key at
# build/run time with:
#   flutter run --dart-define=GEMINI_API_KEY=your_key_here
# The app checks `.env` first, then falls back to `--dart-define`, then
# finally falls back to the fully-offline LocalFallbackService if neither is
# set — it always runs end-to-end either way.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
